ENVIRONMENT=development

POSTGRES_DB=your_dev_database
POSTGRES_USER=your_dev_database_user
POSTGRES_PASSWORD=replace-with-a-local-dev-password
DATABASE_URL=postgresql+asyncpg://your_dev_database_user:replace-with-a-local-dev-password@postgres:5432/your_dev_database

JWT_SECRET_KEY=replace-with-at-least-32-random-bytes

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

FRONTEND_URL=http://localhost:4002
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:4002,http://localhost:4200

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-strong-pgadmin-password

ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=15
ADMIN_REFRESH_TOKEN_EXPIRE_DAYS=14
ADMIN_COOKIE_SAMESITE=lax
